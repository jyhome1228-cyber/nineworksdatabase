{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nineworks-assets",
  "main": "./src/index.js",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/cdn/*"]
  },
  "r2_buckets": [
    {
      "binding": "IMAGE_BUCKET",
      "bucket_name": "nineworks-assets"
    }
  ],
  "observability": {
    "enabled": true
  }
}
